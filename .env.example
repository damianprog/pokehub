# Neon Postgres. DATABASE_URL is the pooled connection (used by the app),
# DIRECT_URL the unpooled one (used by migrations and the seed script).
# Both are under Connection Details in the Neon console.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js. Generate a secret with: npx auth secret
AUTH_SECRET="replace-me"

# GitHub OAuth app. Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="replace-me"
AUTH_GITHUB_SECRET="replace-me"

# Resend, for verification and password-reset emails. Required at startup, but
# a placeholder works while REQUIRE_EMAIL_VERIFICATION is "false".
RESEND_API_KEY="re_replace-me"
# Optional. Defaults to Resend's test sender (onboarding@resend.dev), which can
# only deliver to the Resend account's own address.
RESEND_FROM_EMAIL=""

# Set to "false" to let new accounts sign in without confirming their email.
# Unset or any other value keeps verification required.
REQUIRE_EMAIL_VERIFICATION="false"

# Local only: "true" lets you open the daily pack repeatedly. Ignored in production.
DEV_UNLOCK_ALL="false"
